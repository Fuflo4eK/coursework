#include <time.h>
#include <stdio.h>
#include <stdlib.h>
#include <locale.h>
#include <math.h>
#define _CRT_SECURE_NO_WARNINGS
int main() {
    setlocale(LC_ALL, ".UTF8");
    int n, m, choice;
    int M[25][25];
    int i, j;
    printf("*******************************************************************************\n");
    printf("* Курсовой проект по дисциплине: \"Основы программирования и алгоритмизации\"   *\n");
    printf("* Тема: \"Реализация динамического многомерного массива\"                       *\n");
    printf("* Выполнил: Крупский П.К., группа боти-262                                    *\n");
    printf("*******************************************************************************\n\n");
    srand(time(NULL));
    while (1) {
        printf("МЕНЮ\n");
        printf("1.Ввести матрицу вручную\n");
        printf("2.Сгенерировать случайные числа в матрицу\n");
        printf("3.Выйти из программы\n");
        scanf("%d", &choice);
        if (choice == 3) {
            printf("Выход из программы.\n");
            break;
        }
        printf("Введите количество строк N (до 25): ");
        scanf("%d", &n);
        printf("Введите количество столбцов M (до 25): ");
        scanf("%d", &m);

        if (choice == 1) {
            printf("Введите элементы матрицы:\n");
            for (i = 0; i < n; i++) {
                for (j = 0; j < m; j++) {
                    scanf("%d", &M[i][j]);
                }
            }
        }
        else if (choice == 2) {
            for (i = 0; i < n; i++) {
                for (j = 0; j < m; j++) {
                    // Случайные числа от -25 до 25
                    M[i][j] = rand() % 51 - 25;
                }
            }
        }

        printf("Исходная матрица:\n");
        for (i = 0; i < n; i++) {
            for (j = 0; j < m; j++) {
                printf("%4d ", M[i][j]);
            }
            printf("\n");
        }

        for (i = 0; i < n; i++) {
            int max_idx = 0;
            int min_idx = 0;
            int temp;

            for (j = 1; j < m; j++) {
                if (M[i][j] > M[i][max_idx]) {
                    max_idx = j;
                }
                if (M[i][j] < M[i][min_idx]) {
                    min_idx = j;
                }
            }

            temp = M[i][0];
            M[i][0] = M[i][max_idx];
            M[i][max_idx] = temp;

            temp = M[i][m - 1];
            M[i][m - 1] = M[i][min_idx];
            M[i][min_idx] = temp;
        }

        printf("Полученная матрица:\n");
        for (i = 0; i < n; i++) {
            for (j = 0; j < m; j++) {
                printf("%4d ", M[i][j]);
            }
            printf("\n");
        }
    }
    return 0;
}
