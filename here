#include <stdio.h>
#include <stdlib.h>
#include <time.h>

int main() {
    int n, m, choice;
    int B[50][50]; // Берем массив с запасом, чтобы не использовать динамическую память
    int i, j;

    // Инициализируем генератор случайных чисел
    srand(time(NULL));

    // Простой цикл меню
    while (1) {
        printf("\n--- МЕНЮ ---\n");
        printf("1. Ввести матрицу вручную\n");
        printf("2. Сгенерировать случайные числа\n");
        printf("0. Выход\n");
        printf("Ваш выбор: ");
        scanf("%d", &choice);

        if (choice == 0) {
            printf("Выход из программы.\n");
            break;
        }

        if (choice != 1 && choice != 2) {
            printf("Неверный выбор! Попробуйте снова.\n");
            continue;
        }

        // Ввод размеров матрицы
        printf("Введите количество строк N (до 50): ");
        scanf("%d", &n);
        printf("Введите количество столбцов M (до 50): ");
        scanf("%d", &m);

        // Заполнение матрицы в зависимости от выбора
        if (choice == 1) {
            printf("Введите элементы матрицы:\n");
            for (i = 0; i < n; i++) {
                for (j = 0; j < m; j++) {
                    scanf("%d", &B[i][j]);
                }
            }
        } else if (choice == 2) {
            for (i = 0; i < n; i++) {
                for (j = 0; j < m; j++) {
                    // Случайные числа от -50 до 50
                    B[i][j] = rand() % 101 - 50; 
                }
            }
        }

        // Вывод исходной матрицы
        printf("\nИсходная матрица:\n");
        for (i = 0; i < n; i++) {
            for (j = 0; j < m; j++) {
                printf("%4d ", B[i][j]);
            }
            printf("\n");
        }

        // Основной алгоритм решения задачи
        for (i = 0; i < n; i++) {
            int max_idx = 0;
            int min_idx = 0;
            int temp;

            // Ищем индексы max и min в текущей строке
            for (j = 1; j < m; j++) {
                if (B[i][j] > B[i][max_idx]) {
                    max_idx = j;
                }
                if (B[i][j] < B[i][min_idx]) {
                    min_idx = j;
                }
            }

            // Меняем максимальный элемент с первым элементом строки (B[i][0])
            temp = B[i][0];
            B[i][0] = B[i][max_idx];
            B[i][max_idx] = temp;

            // Если минимальный элемент стоял в самом начале (на 0 месте),
            // то после обмена он переехал на место max_idx. Учитываем это:
            if (min_idx == 0) {
                min_idx = max_idx;
            }

            // Меняем минимальный элемент с последним элементом строки (B[i][m - 1])
            temp = B[i][m - 1];
            B[i][m - 1] = B[i][min_idx];
            B[i][min_idx] = temp;
        }

        // Вывод результата
        printf("\nПолученная матрица:\n");
        for (i = 0; i < n; i++) {
            for (j = 0; j < m; j++) {
                printf("%4d ", B[i][j]);
            }
            printf("\n");
        }
    }

    return 0;
}
