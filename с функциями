#define _CRT_SECURE_NO_WARNINGS
#include <time.h>
#include <stdio.h>
#include <stdlib.h>
#include <locale.h>
#define MAX_SIZE 25
void printHeader() {
    printf("*******************************************************************************\n");
    printf("* Курсовой проект по дисциплине: \"Основы программирования и алгоритмизации\" *\n");
    printf("* Тема: \"Реализация динамического многомерного массива\"                     *\n");
    printf("* Выполнил: Крупский П.К., группа боти-262                                    *\n");
    printf("*******************************************************************************\n\n");
}
int getMenuChoice() {
    int choice;
    printf("МЕНЮ\n");
    printf("1. Ввести матрицу вручную\n");
    printf("2. Сгенерировать случайные числа в матрицу\n");
    printf("3. Выйти из программы\n");
    scanf("%d", &choice);
    return choice;
}
void inputMatrix(int M[MAX_SIZE][MAX_SIZE], int n, int m) {
    printf("Введите элементы матрицы:\n");
    for (int i = 0; i < n; i++) {
        for (int j = 0; j < m; j++) {
            scanf("%d", &M[i][j]);
        }
    }
}
void generateMatrix(int M[MAX_SIZE][MAX_SIZE], int n, int m) {
    for (int i = 0; i < n; i++) {
        for (int j = 0; j < m; j++) {
            M[i][j] = rand() % 51 - 25;
        }
    }
}
void printMatrix(int M[MAX_SIZE][MAX_SIZE], int n, int m) {
    for (int i = 0; i < n; i++) {
        for (int j = 0; j < m; j++) {
            printf("%4d ", M[i][j]);
        }
        printf("\n");
    }
}
void swapMinMaxInRows(int M[MAX_SIZE][MAX_SIZE], int n, int m) {
    for (int i = 0; i < n; i++) {
        int max_idx = 0;
        int min_idx = 0;
        int temp;

        for (int j = 1; j < m; j++) {
            if (M[i][j] > M[i][max_idx]) {
                max_idx = j;
            }
            if (M[i][j] < M[i][min_idx]) {
                min_idx = j;
            }
        }
        temp = M[i][0];
        M[i][0] = M[i][max_idx];
        M[i][max_idx] = temp;
        if (min_idx == 0) {
            min_idx = max_idx;
        }
        temp = M[i][m - 1];
        M[i][m - 1] = M[i][min_idx];
        M[i][min_idx] = temp;
    }
}
int main() {
    setlocale(LC_ALL, ".UTF8");
    srand((unsigned int)time(NULL));
    int n, m, choice;
    int M[MAX_SIZE][MAX_SIZE];
    printHeader();
    while (1) {
        choice = getMenuChoice();
        if (choice == 3) {
            printf("Выход из программы.\n");
            break;
        }
        if (choice != 1 && choice != 2) {
            printf("Неверный пункт меню. Попробуйте снова.\n\n");
            continue;
        }
        printf("Введите количество строк N (до %d): ", MAX_SIZE);
        scanf("%d", &n);
        printf("Введите количество столбцов M (до %d): ", MAX_SIZE);
        scanf("%d", &m);
        if (choice == 1) {
            inputMatrix(M, n, m);
        } else {
            generateMatrix(M, n, m);
        }
        printf("Исходная матрица:\n");
        printMatrix(M, n, m);
        swapMinMaxInRows(M, n, m);
        printf("Полученная матрица:\n");
        printMatrix(M, n, m);
        printf("\n");
    }
    return 0;
}
